void myTrim(std::string &s)
{
	size_t i = 0;
    while (i < s.size() && std::isspace(s[i]))
        i++;
    s.erase(0, i);
	size_t end = s.size();
    while (end > 0 && std::isspace(s[i - 1]))
        end--;
    s.erase(end);
}

bool firstValidation(std::string &input)
{
    if (input.empty())
        return false;
    myTrim(input);
    if (input.empty())
        return false;
    if (input.find_first_of(" \t\n\r\f\v") != std::string::npos)
        return false;
    return true;
}

Type getType(std::string &input)
{
    if (!firstValidation(input))
        return INVALID;
    if (input.length() == 1 && isdigit(input[0]) == false)
        return CHAR;
    if (input == "nan" || input == "+inf" || input == "-inf")
        return DOUBLE;
    if (input == "nanf" || input == "+inff" || input == "-inff")
        return FLOAT;
    char *endptr;
    std::strtod(input.c_str(), &endptr);
    if (endptr == input.c_str())
        return INVALID;
    // DOUBLE
    if (*endptr == '\0')
    {
        if (input.find('.') != std::string::npos)
            return DOUBLE;
        return INT;
    }
    // FLOAT
    if (*endptr == 'f' && *(endptr + 1) == '\0')
        return FLOAT;
    return INVALID;
}